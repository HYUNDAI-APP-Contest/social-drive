<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- AWS API/S3 access and WorkManager's connected-network constraint. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Read-only transmission selection; vehicle-control permissions remain forbidden. -->
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />
    <!-- The only NaviHelper operation used is route search. -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE_SEARCH" />
    <!-- Vehicle location is collected only after explicit in-app and runtime consent. -->
    <uses-permission android:name="pleos.car.permission.FUSED_LOCATION" />
    <!-- Speech services support distraction-minimized prompts and parked editing. -->
    <uses-permission android:name="pleos.car.permission.TTS_SERVICE" />
    <uses-permission android:name="pleos.car.permission.STT_SERVICE" />
</manifest>
