# GitHub
GITHUB_OWNER=HYUNDAI-APP-Contest
GITHUB_REPO=social-drive
GITHUB_TOKEN=
GITHUB_READY_LABEL=agent:ready
GITHUB_BASE_BRANCH=main
# Optional until `node --env-file=.env scripts/setup-control-center.mjs --apply` creates the private org Project.
GITHUB_PROJECT_ID=
GITHUB_PROJECT_URL=

# Discord. The webhook reports progress; the bot token reads approval commands.
DISCORD_WEBHOOK_URL=
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
DISCORD_GUILD_ID=
DISCORD_APPLICATION_ID=
DISCORD_APPROVER_USER_IDS=
DISCORD_BOOTSTRAP_CODE=
DISCORD_DISPLAY_NAME=개발자
# Keep routine 아키/픽시/센티넬 transcripts out of the main channel by default.
DISCORD_AVATAR_PATH=./orchestrator/assets/developer-avatar.png
DISCORD_ARCHITECT_AVATAR_PATH=./orchestrator/assets/personas/aki-architect.png
DISCORD_DESIGNER_AVATAR_PATH=./orchestrator/assets/personas/pixie-designer.png
DISCORD_REVIEWER_AVATAR_PATH=./orchestrator/assets/personas/sentinel-reviewer.png

# Codex. setup-orchestrator.sh discovers and writes the platform-specific absolute path.
CODEX_EXECUTABLE=/absolute/path/to/codex
CODEX_MODEL=
MAX_PARALLEL_AGENTS=3
MAX_REVIEW_ROUNDS=2
POLL_INTERVAL_SECONDS=30
TURN_TIMEOUT_MINUTES=90
APP_SERVER_REQUEST_TIMEOUT_SECONDS=20
MAX_RETRIES=3
USAGE_LIMIT_COOLDOWN_MINUTES=60

# Guardrails and cost circuit breakers
DAILY_TOKEN_LIMIT=2000000
DAILY_COST_LIMIT_USD=25
ESTIMATED_USD_PER_1M_TOKENS=10
ACCOUNT_USAGE_PAUSE_PERCENT=95
ACCOUNT_USAGE_MAX_AGE_SECONDS=300
ACCOUNT_USAGE_SYNC_SECONDS=60
APPROVAL_TTL_MINUTES=720
PR_HANDOFF_NOT_BEFORE_HOUR_KST=8

# Runtime paths. Defaults work both locally and in Docker Compose.
SOURCE_REPOSITORY=.
WORKSPACE_ROOT=./orchestrator/workspaces
STATE_PATH=./orchestrator/data/state.json
DASHBOARD_PATH=./status-dashboard.html
DASHBOARD_INTERVAL_SECONDS=10
OUTBOX_INTERVAL_SECONDS=10
OUTBOX_MAX_ATTEMPTS=8
DEPLOYMENT_ROOT=./orchestrator/deployments
LOG_LEVEL=info

# AWS host-only deployment gateway. No access key is stored here; the named AWS CLI profile is used.
AWS_DEPLOY_ENABLED=true
AWS_COMMAND=/usr/local/bin/aws
AWS_PROFILE=social-drive-deployer
AWS_REGION=ap-northeast-2
AWS_STACK_NAME=social-drive-dev
AWS_ENVIRONMENT=dev
AWS_ARTIFACT_BUCKET=
AWS_CLOUDFORMATION_ROLE_ARN=
AWS_DEPLOYMENT_TIMEOUT_MINUTES=30

